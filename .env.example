# Server-only URL for the Go service. Do not expose this as NEXT_PUBLIC_*. 
FAUCET_GRAPH_URL=https://faucet-graph.florin.so

# Public Cloudflare Turnstile site key. The SPN_TURNSTILE_SECRET stays in Go.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Go service only: X OAuth 2.0 + PKCE configuration.
SPN_X_CLIENT_ID=your-x-oauth2-client-id
SPN_X_CLIENT_SECRET=your-x-oauth2-client-secret
SPN_X_SESSION_SECRET=generate-at-least-32-random-characters
SPN_X_REDIRECT_URIS=http://localhost:3000/auth/x/callback,https://faucet.florin.so/auth/x/callback
SPN_X_REQUIRED_USERNAME=florinprotocol
# Recommended: pin @florinprotocol's immutable X user ID.
SPN_X_REQUIRED_USER_ID=
