# Server-only URL for the Go service. Do not expose this as NEXT_PUBLIC_*. 
FAUCET_GRAPH_URL=https://faucet-graph.florin.so

# Cloudflare Turnstile's public site key is embedded in components/turnstile.tsx.
# Go service only: keep the widget secret server-side and restrict successful
# Siteverify responses to the frontend hostname for this deployment.
SPN_TURNSTILE_SECRET=***
SPN_TURNSTILE_HOSTNAMES=faucet.florin.so

# Go service only: X OAuth 2.0 + PKCE configuration (not used for faucet claims).
SPN_X_CLIENT_ID=[REDACTED]
SPN_X_CLIENT_SECRET=[REDACTED]
SPN_X_SESSION_SECRET=[REDACTED]
SPN_X_REDIRECT_URIS=http://localhost:3000/auth/x/callback,https://faucet.florin.so/auth/x/callback
