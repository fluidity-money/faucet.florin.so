[Unit]
Description=Florin Faucet
Requires=florin-faucet.socket
After=florin-faucet.socket

[Service]
Type=simple
User=
Group=
EnvironmentFile=/etc/fluidity-apps/robinhood-testnet.conf
ExecStart=/usr/local/bin/florin-faucet
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
